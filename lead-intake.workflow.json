{
  "id": "leadIntake01",
  "name": "Lead intake: webhook → validate → Telegram + Data Table",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-intake",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        200
      ],
      "webhookId": "lead-intake",
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "Lead intake token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Проверка и нормализация заявки из формы/бота\nconst body = $input.first().json.body || {};\nconst errors = [];\n\nconst name = String(body.name || '').trim();\nconst message = String(body.message || '').trim();\nconst source = String(body.source || 'unknown').trim().slice(0, 40);\n\n// телефон: оставляем только цифры, требуем 10-15 цифр\nconst rawPhone = String(body.phone || '').trim();\nconst digits = rawPhone.replace(/\\D/g, '');\n// российский формат 8XXXXXXXXXX -> +7XXXXXXXXXX\nconst normalized = (digits.length === 11 && digits.startsWith('8')) ? '7' + digits.slice(1) : digits;\nconst phone = normalized ? '+' + normalized : '';\n\nif (name.length < 2) errors.push('name: минимум 2 символа');\nif (digits.length < 10 || digits.length > 15) errors.push('phone: нужно 10-15 цифр');\nif (message.length < 3) errors.push('message: минимум 3 символа');\n\nconst lead = {\n  id: 'L' + Date.now().toString(36).toUpperCase(),\n  createdAt: new Date().toISOString(),\n  name, phone, message, source,\n};\n\nreturn [{ json: { valid: errors.length === 0, errors, lead } }];"
      },
      "id": "n2",
      "name": "Validate & normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n3",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "chatId": "YOUR_TELEGRAM_CHAT_ID",
        "text": "=🆕 Новая заявка {{ $json.lead.id }}\nИмя: {{ $json.lead.name }}\nТелефон: {{ $json.lead.phone }}\nИсточник: {{ $json.lead.source }}\n\n{{ $json.lead.message }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "n4",
      "name": "Notify admin (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        680,
        100
      ],
      "onError": "continueRegularOutput",
      "credentials": {}
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "insert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "leads"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "leadId": "={{ $('Validate & normalize').item.json.lead.id }}",
            "submittedAt": "={{ $('Validate & normalize').item.json.lead.createdAt }}",
            "name": "={{ $('Validate & normalize').item.json.lead.name }}",
            "phone": "={{ $('Validate & normalize').item.json.lead.phone }}",
            "message": "={{ $('Validate & normalize').item.json.lead.message }}",
            "source": "={{ $('Validate & normalize').item.json.lead.source }}"
          },
          "matchingColumns": [],
          "schema": []
        }
      },
      "id": "n5",
      "name": "Save to Data Table",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        900,
        100
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', id: $('Validate & normalize').item.json.lead.id } }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "n6",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'error', errors: $json.errors } }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "n7",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        680,
        320
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate & normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & normalize": {
      "main": [
        [
          {
            "node": "Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Valid?": {
      "main": [
        [
          {
            "node": "Notify admin (Telegram)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify admin (Telegram)": {
      "main": [
        [
          {
            "node": "Save to Data Table",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save to Data Table": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}